{
  "name": "gpt-web-codex-launcher",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "package:win": "node scripts/package.cjs",
    "smoke:package": "node scripts/smoke-package.cjs"
  },
  "build": {
    "appId": "com.openai.gpt-web-codex",
    "productName": "GPT Web Codex",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**/*",
      "electron/connector-identity.cjs",
      "electron/doctor.cjs",
      "electron/launcher-state.cjs",
      "electron/main.cjs",
      "electron/mcp-credentials.cjs",
      "electron/memory-store.cjs",
      "electron/preload.cjs",
      "electron/profiles.cjs",
      "electron/proxy-service.cjs",
      "electron/registry.cjs",
      "electron/runtime-client.cjs",
      "electron/runtime-supervisor.cjs",
      "electron/skills.cjs",
      "electron/state.cjs",
      "electron/tunnel-client.cjs",
      "electron/tunnel-supervisor.cjs",
      "electron/app-icon.png",
      "electron/app-icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".package/core",
        "to": "core",
        "filter": [
          "**/*",
          "!node_modules{,/**/*}"
        ]
      },
      {
        "from": ".package/core/node_modules",
        "to": "core/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/tools/tunnel-client.exe",
        "to": "tools/tunnel-client.exe"
      }
    ],
    "win": {
      "icon": "electron/app-icon.ico",
      "signAndEditExecutable": false,
      "signExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
